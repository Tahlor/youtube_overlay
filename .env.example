HOST=0.0.0.0
PORT=3001

# Production reverse-proxy example:
# BASE_PATH=/youtube_overlay
# VITE_BASE_PATH=/youtube_overlay/

# Optional persistent SQLite file (default data/overlay.sqlite):
# DATA_PATH=/absolute/path/overlay.sqlite

# Optional TURN relay for phone inputs on restrictive networks. Set at build time.
# VITE_TURN_URL=turn:turn.example.com:3478
# VITE_TURN_USERNAME=temporary-user
# VITE_TURN_CREDENTIAL=temporary-password
