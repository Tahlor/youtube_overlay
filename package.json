{
  "name": "youtube-overlay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite --host 0.0.0.0\" \"tsx watch server/index.ts\"",
    "build": "tsc -p tsconfig.server.json && vite build && node scripts/build-info.mjs",
    "start": "node dist-server/server/index.js",
    "test": "tsx --test tests/*.test.ts",
    "check": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit && npm run build && npm test",
    "test:browser": "node tests/browser.mjs",
    "test:playback": "node tests/playback-browser.mjs",
    "test:broadcast": "node tests/broadcast-browser.mjs",
    "test:input": "node tests/input-browser.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "playwright-core": "^1.63.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.7"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
